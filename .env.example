# 复制成 .env 后再填真实值。
# .env 已在 .gitignore 中被忽略, 不会被提交。
#
# 进程环境变量优先于本文件; Windows 上若用 setx 写过, 需要重开终端才能读到。

# ---- 洛谷登录态 (可选: 不填则打卡与自动取题都不可用, 只能粘贴题面) ----
# 获取方式: 浏览器登录 luogu.com.cn -> F12 -> Application -> Cookie -> https://luogu.com.cn
#   __client_id -> LUOGU_CLIENT_ID  (字母数字)
#   _uid       -> LUOGU_UID        (纯数字)
LUOGU_CLIENT_ID=
LUOGU_UID=

# ---- 模型后端 (讲解功能需要; 只在服务端读取, 绝不进浏览器) ----
# 五个厂家各一套, 填哪家的密钥就能在网页上选哪家。厂商与协议见 explainer/providers.json。
# Anthropic 兼容端点 (MiniMax):
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash
# OpenAI 兼容端点 (DeepSeek):
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenAI 兼容端点 (Kimi / 月之暗面):
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-latest
# OpenAI 兼容端点 (通义千问 / 百炼):
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# OpenAI 兼容端点 (智谱 GLM):
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPUAI_API_KEY=
ZHIPUAI_MODEL=glm-4-plus
# 自建端点 (Ollama / vLLM / 第三方中转):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 网页应用 ----
# 服务监听地址与端口 (默认 127.0.0.1:8848)
LUOGUBOT_HOST=127.0.0.1
LUOGUBOT_PORT=8848
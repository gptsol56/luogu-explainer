# 复制成 .env 后再填真实值。
# .env 已在 .gitignore 中被忽略, 不会被提交。
#
# 进程环境变量优先于本文件; Windows 上若用 setx 写过, 需要重开终端才能读到。

# ---- 洛谷登录态 (可选: 不填则打卡与自动取题都不可用, 只能粘贴题面) ----
# 获取方式: 浏览器登录 luogu.com.cn -> F12 -> Application -> Cookie -> https://luogu.com.cn
#   __client_id -> LUOGU_CLIENT_ID  (字母数字)
#   _uid       -> LUOGU_UID        (纯数字)
LUOGU_CLIENT_ID=
LUOGU_UID=

# ---- 模型后端 (讲解功能需要; 只在服务端读取, 绝不进浏览器) ----
# Anthropic 兼容端点, 形如 https://api.minimaxi.com/anthropic
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash

# ---- 网页应用 ----
# 服务监听地址与端口 (默认 127.0.0.1:8848)
LUOGUBOT_HOST=127.0.0.1
LUOGUBOT_PORT=8848